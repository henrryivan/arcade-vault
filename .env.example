# Copia este archivo a .env.local y rellena los valores. Solo servidor: sin prefijo NEXT_PUBLIC_.

# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxx

# Remitente. En desarrollo: onboarding@resend.dev. En producción: un dominio verificado en Resend.
RESEND_FROM_EMAIL=onboarding@resend.dev

# Destino de los mensajes del formulario de contacto.
# Con onboarding@resend.dev solo entrega al correo dueño de la cuenta de Resend.
CONTACT_TO_EMAIL=equipo@ejemplo.com

# Supabase: públicas (se exponen al navegador). Usar SIEMPRE la clave publishable (sb_publishable_...),
# nunca la secret ni la service_role.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Solo para la CLI de Supabase (supabase link / db push). Nunca en código de la app.
SUPABASE_DB_PASSWORD=XXXXX